# Copy to .env for local development. Never commit real secrets.
# Use a dedicated non-production OIDC application and resource-server audience.
DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS=RS256
PORT=3000

# Bounded HTTP and PostgreSQL resource usage.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000
