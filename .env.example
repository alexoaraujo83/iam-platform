# Copy to .env for local development. Never commit real secrets.
# Use a dedicated non-production OIDC application and resource-server audience.
DATABASE_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS=RS256
PORT=3000

# Bounded HTTP and PostgreSQL resource usage.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000

# Auth0 Next.js SDK (apps/web). Configure values in the deployment secret store.
# AUTH0_AUDIENCE must match the Identifier of the Custom API.
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://iam-platform-api
APP_BASE_URL=http://localhost:3000

# Server-side diagnostics (Preview only; never set these in Production).
# IAM_API_BASE_URL must point to the matching, trusted IAM API Preview endpoint.
IAM_API_BASE_URL=
# Seeded in the Neon "preview" branch; keep these fixtures isolated from Production.
IAM_DIAGNOSTICS_TENANT_ID=4a2f0b2e-37c1-4d0a-a211-8b6d7f2e9001
IAM_DIAGNOSTICS_NO_MEMBERSHIP_TENANT_ID=4a2f0b2e-37c1-4d0a-a211-8b6d7f2e9101
IAM_DIAGNOSTICS_NO_PERMISSION_TENANT_ID=4a2f0b2e-37c1-4d0a-a211-8b6d7f2e9201
IAM_DIAGNOSTICS_OTHER_TENANT_ID=4a2f0b2e-37c1-4d0a-a211-8b6d7f2e9301
# Leave empty until a genuine, validly signed test JWT has expired. Never use a modified or forged token.
IAM_DIAGNOSTICS_EXPIRED_ACCESS_TOKEN=
