# Copy to .env for local development. Never commit real secrets.
# Use a dedicated non-production OIDC application and resource-server audience.
DATABASE_URL=
# Optional, dedicated LOGIN role with EXECUTE-only access to the provisioning function.
# Never reuse DATABASE_URL or the normal iam_app_runtime credential.
IDENTITY_PROVISIONER_DATABASE_URL=
IDENTITY_PROVISIONER_POOL_MAX=2
# Non-secret expected Neon target used to fail closed on wrong runtime/provisioner branch.
IAM_EXPECTED_NEON_BRANCH_ID=
IAM_EXPECTED_NEON_PROJECT_ID=
# Keep disabled in both API and Web until a dedicated Preview E2E is approved.
IAM_IDENTITY_BOOTSTRAP_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS=RS256
PORT=3000

# Bounded HTTP and PostgreSQL resource usage.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000

# Auth0 Next.js SDK (apps/web). Configure values in the deployment secret store.
# AUTH0_AUDIENCE must match the Identifier of the Custom API.
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://iam-platform-api
APP_BASE_URL=http://localhost:3000
IAM_API_BASE_URL=
