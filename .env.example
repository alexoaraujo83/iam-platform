# Copy to .env for local development. Never commit real secrets.
# Use a dedicated non-production OIDC application and resource-server audience.
# Start a local PostgreSQL instance and replace the placeholder password before running the API.
DATABASE_URL=postgresql://iam_app_runtime:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/iam_platform?sslmode=disable
OIDC_ISSUER=https://iam-platform.us.auth0.com/
OIDC_AUDIENCE=https://iam-platform-api
OIDC_JWKS_URI=https://iam-platform.us.auth0.com/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256
PORT=3000

# Bounded HTTP and PostgreSQL resource usage.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_GRACE_MS=10000

# Auth0 Next.js SDK (apps/web). Configure values in the deployment secret store.
# AUTH0_AUDIENCE must match the Identifier of the Custom API.
# Generate AUTH0_SECRET with: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_DOMAIN=iam-platform.us.auth0.com
AUTH0_CLIENT_ID=dRNakvgiRaMrByaVZ9mGN7Pl2VCGNRf7
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://iam-platform-api
APP_BASE_URL=http://localhost:3000
